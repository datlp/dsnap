#include <windows.h>
#include "resource.h"
#include "version.h"

IDI_APPICON ICON "dsnap.ico"
1 24 "dsnap.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    DSNAP_VERSION_RC
 PRODUCTVERSION DSNAP_VERSION_RC
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "datlp"
            VALUE "FileDescription",  "dsnap - lightweight screenshot and screen recorder"
            VALUE "FileVersion",      DSNAP_VERSION_STR
            VALUE "InternalName",     "dsnap"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "dsnap.exe"
            VALUE "ProductName",      "dsnap"
            VALUE "ProductVersion",   DSNAP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
